datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Run {
  run_id          String    @id @default(uuid()) @db.VarChar(36)
  run_category_id String    @db.VarChar(36) // FOREIGN KEY that connects to the Game-Service
  user_id         String    @db.VarChar(36) // FOREIGN KEY that connects to the Auth-Service
  vod_url         String    @db.VarChar(255)
  run_duration    BigInt    
  submitted_at    DateTime  @default(now()) @db.DateTime
  verified_at     DateTime? @db.DateTime  // Nullable vield
  status          String    @default("PENDING") @db.VarChar(25) // PENDING, ACCEPTED, REJECTED

  // Internal One-to-Many relation mapping to comments within this service
  comments        Comment[]

  @@map("runs")
}

model Comment {
  comment_id String   @id @default(uuid()) @db.VarChar(36)
  run_id     String   @db.VarChar(36)
  user_id    String   @db.VarChar(36) // FOREIGN KEY that connects to the Auth-Service
  comment    String   @db.VarChar(255)
  created_at DateTime @default(now()) @db.DateTime

  // Internal structural relation back to the associated parent Run entry
  run        Run      @relation(fields: [run_id], references: [run_id], onDelete: Cascade)

  @@map("comments")
}